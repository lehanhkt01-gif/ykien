# Cấu hình Database PostgreSQL
DB_USER=postgres
DB_PASSWORD=EaSupSecuredPass2026!
DB_NAME=voter_feedback_db
DB_HOST=db
DB_PORT=5432

# Chuỗi kết nối Prisma (Dùng trong mạng docker compose trỏ tới container db)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}?schema=public"

# Khi chạy local không qua Docker, dùng:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voter_feedback_db?schema=public"

# Bảo mật JWT Session cho Cán bộ Quản trị
JWT_SECRET="easup_voter_feedback_jwt_secret_super_key_2026_production"

# Tài khoản Quản trị viên khởi tạo
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@EaSup2026!

# Bảo mật NextAuth v5 & Google OAuth
AUTH_SECRET="easup_auth_secret_random_string_key_2026_change_me"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Thông tin Đơn vị
NEXT_PUBLIC_APP_NAME="TIẾNG NÓI CỬ TRI - Cầu nối số minh bạch giữa Cử tri và Chính quyền địa phương"
NEXT_PUBLIC_HOTLINE="0262.3688.115"
NEXT_PUBLIC_EMAIL="mttq.easup@daklak.gov.vn"
NEXT_PUBLIC_ADDRESS="Xã Ea Súp, Tỉnh Đắk Lắk"
